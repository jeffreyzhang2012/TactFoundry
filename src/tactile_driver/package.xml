<?xml version="1.0"?>
<package format="3">
  <name>tactile_driver</name>
  <version>0.1.0</version>
  <description>Serial tactile hardware acquisition and health reporting.</description>
  <maintainer email="maintainers@example.com">Tact Foundry maintainers</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
